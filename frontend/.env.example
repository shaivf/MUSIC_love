# 前端环境变量配置示例
# 使用方法: 复制此文件为 .env.local（开发）或 .env.production（生产），根据需要修改值

# ============================================
# API 配置（必填）
# ============================================
# API 基础 URL（关键变量）
# 开发环境: /api （Vite proxy 转发到 http://localhost:3000）
# 生产环境: https://api.yourdomain.com 或相对路径 /api
VITE_API_BASE_URL=/api

# ============================================
# 应用配置
# ============================================
# 应用名称
VITE_APP_TITLE=Music Showcase

# 应用模式
VITE_APP_MODE=development

# ============================================
# 日志配置
# ============================================
# 日志级别 (debug, info, warn, error)
VITE_LOG_LEVEL=info

# ============================================
# 生产环境部署时的配置
# ============================================
# VITE_API_BASE_URL=https://api.yourdomain.com
# VITE_APP_MODE=production
# VITE_LOG_LEVEL=warn
